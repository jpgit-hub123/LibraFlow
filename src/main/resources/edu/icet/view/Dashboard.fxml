<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Button?>


<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.icet.controller.DashboardPageController"
            styleClass="root-container">

    <!-- Sidebar -->
    <left>
        <VBox prefWidth="220"
              spacing="20"
              styleClass="sidebar"
              BorderPane.alignment="CENTER">

            <padding>
                <Insets top="30" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="LibraFlow"
                   styleClass="logo"/>

            <Label text="MAIN MENU"
                   styleClass="menu-heading"/>

            <Button text="Dashboard"
                    onAction="#showDashboardOnAction"
                    styleClass="menu-button, active-menu"/>

            <Button text="Books"
                    onAction="#showBooksOnAction"
                    styleClass="menu-button"/>

            <Button text="Members"
                    onAction="#showMembersOnAction"
                    styleClass="menu-button"/>

            <Button text="Issue &amp; Return"
                    onAction="#showIssueReturnOnAction"
                    styleClass="menu-button"/>
        </VBox>
    </left>

    <!-- Main Content -->
    <center>
        <VBox spacing="25"
              styleClass="main-content">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <HBox alignment="CENTER_LEFT">
                <VBox spacing="5">
                    <Label text="Dashboard"
                           styleClass="page-title"/>

                    <Label text="Welcome to your library management system."
                           styleClass="subtitle"/>
                </VBox>
            </HBox>

            <!-- Statistics -->
            <HBox spacing="20">

                <VBox spacing="12"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="TOTAL BOOKS"
                           styleClass="stat-label"/>

                    <Label fx:id="totalBooksLabel"
                           text="0"
                           styleClass="stat-value"/>

                    <Label text="Books in the library"
                           styleClass="stat-description"/>

                </VBox>

                <VBox spacing="12"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="TOTAL QUANTITY"
                           styleClass="stat-label"/>

                    <Label fx:id="totalQuantityLabel"
                            text="0"
                           styleClass="stat-value"/>

                    <Label text="Total copies of all books"
                           styleClass="stat-description"/>

                </VBox>

                <VBox spacing="12"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="TOTAL CATEGORIES"
                           styleClass="stat-label"/>

                    <Label fx:id="totalCategoryLabel"
                            text="0"
                           styleClass="stat-value"/>

                    <Label text="Different book categories"
                           styleClass="stat-description"/>

                </VBox>

                <VBox spacing="12"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="TOTAL MEMBERS"
                           styleClass="stat-label"/>

                    <Label fx:id="totalMembersLabel"
                           text="0"
                           styleClass="stat-value"/>

                    <Label
                            text="Registered library members"
                            styleClass="stat-description"/>

                </VBox>

<!--                <VBox spacing="12"-->
<!--                      HBox.hgrow="ALWAYS"-->
<!--                      styleClass="stat-card">-->

<!--                    <Label text="OVERDUE BOOKS"-->
<!--                           styleClass="stat-label"/>-->

<!--                    <Label text="0"-->
<!--                           styleClass="stat-value"/>-->

<!--                    <Label text="Past their due date"-->
<!--                           styleClass="stat-description"/>-->

<!--                </VBox>-->

            </HBox>

            <!-- Recent Transactions -->
            <VBox spacing="15"
                  styleClass="transactions-card">

                <Label text="Recent Transactions"
                       styleClass="section-title"/>

                <TableView fx:id="recentTransactionsTable"
                           prefHeight="300"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="transactionMemberColumn"
                                     text="Member ID"
                                     prefWidth="100"/>

                        <TableColumn fx:id="transactionBookColumn"
                                     text="Book Title"
                                     prefWidth="220"/>

                        <TableColumn fx:id="transactionTypeColumn"
                                     text="Transaction"
                                     prefWidth="120"/>

                        <TableColumn fx:id="transactionDateColumn"
                                     text="Date"
                                     prefWidth="130"/>

                        <TableColumn fx:id="transactionStatusColumn"
                                     text="Status"
                                     prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>


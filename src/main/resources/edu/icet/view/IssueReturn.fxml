<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.icet.controller.IssueReturnPageController"
            styleClass="root-container">

    <left>
        <VBox prefWidth="220"
              spacing="20"
              styleClass="sidebar">

            <padding>
                <Insets top="30" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="LibraFlow"
                   styleClass="logo"/>

            <Label text="MAIN MENU"
                   styleClass="menu-heading"/>

            <Button text="Dashboard"
                    onAction="#showDashboardOnAction"
                    styleClass="menu-button"/>

            <Button text="Books"
                    onAction="#showBooksOnAction"
                    styleClass="menu-button"/>

            <Button text="Members"
                    onAction="#showMembersOnAction"
                    styleClass="menu-button"/>

            <Button text="Issue &amp; Return"
                    styleClass="menu-button, active-menu"/>

            <Button text="Reports"
                    styleClass="menu-button"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="20"
              styleClass="main-content">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <!-- Page heading -->

            <VBox spacing="5">
                <Label text="Issue &amp; Return"
                       styleClass="page-title"/>

                <Label text="Manage book issues and returns"
                       styleClass="subtitle"/>
            </VBox>

            <!-- Summary cards -->

            <HBox spacing="15">

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="TOTAL ISSUED BOOKS"
                           styleClass="stat-label"/>

                    <Label text="0"
                           styleClass="stat-value"/>

                </VBox>

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="CURRENTLY BORROWED"
                           styleClass="stat-label"/>

                    <Label text="0"
                           styleClass="stat-value"/>

                </VBox>

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="RETURNED BOOKS"
                           styleClass="stat-label"/>

                    <Label text="0"
                           styleClass="stat-value"/>

                </VBox>

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="stat-card">

                    <Label text="OVERDUE BOOKS"
                           styleClass="stat-label"/>

                    <Label text="0"
                           styleClass="stat-value"/>

                </VBox>

            </HBox>

            <!-- Issue book form -->

            <VBox spacing="20"
                  styleClass="transactions-card">

                <Label text="Issue a Book"
                       styleClass="section-title"/>

                <HBox spacing="15">

                    <!-- Select Member -->

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Select Member"/>

                        <ComboBox fx:id="memberComboBox"
                                  promptText="Choose a member"
                                  maxWidth="Infinity"
                                  prefHeight="38"/>

                    </VBox>

                    <!-- Select Book -->

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Select Book"/>

                        <ComboBox fx:id="bookComboBox"
                                  promptText="Choose a book"
                                  maxWidth="Infinity"
                                  prefHeight="38"/>

                    </VBox>

                </HBox>

                <HBox spacing="15">

                    <!-- Issue Date -->

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Issue Date"/>

                        <DatePicker fx:id="issueDatePicker"
                                    maxWidth="Infinity"
                                    prefHeight="38"/>

                    </VBox>

                    <!-- Due Date -->

                    <VBox spacing="8"
                          HBox.hgrow="ALWAYS">

                        <Label text="Due Date"/>

                        <DatePicker fx:id="dueDatePicker"
                                    maxWidth="Infinity"
                                    prefHeight="38"/>

                    </VBox>

                </HBox>

                <HBox alignment="CENTER_RIGHT">

                    <Button text="Issue Book"
                            onAction="#issueBookOnAction"
                            styleClass="primary-button"/>

                </HBox>

            </VBox>

            <!-- Issued books table -->

            <VBox spacing="15"
                  styleClass="transactions-card"
                  VBox.vgrow="ALWAYS">

                <HBox alignment="CENTER_LEFT"
                      spacing="15">

                    <Label text="Issued Books"
                           styleClass="section-title"
                           HBox.hgrow="ALWAYS"/>

<!--                    <TextField fx:id="searchField"-->
<!--                               promptText="Search issued books..."-->
<!--                               prefWidth="280"/>-->

                </HBox>

                <TableView fx:id="issuedBooksTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="memberIdColumn"
                                     text="Member ID"
                                     prefWidth="100"/>

                        <TableColumn fx:id="isbnColumn"
                                     text="ISBN"
                                     prefWidth="100"/>

                        <TableColumn fx:id="bookTitleColumn"
                                     text="Book Title"
                                     prefWidth="180"/>

                        <TableColumn fx:id="issueDateColumn"
                                     text="Issue Date"
                                     prefWidth="120"/>

                        <TableColumn fx:id="dueDateColumn"
                                     text="Due Date"
                                     prefWidth="120"/>

                        <TableColumn fx:id="statusColumn"
                                     text="Status"
                                     prefWidth="110"/>

                        <TableColumn fx:id="overdueDaysColumn"
                                     text="Overdue Days"
                                     prefWidth="110"/>

                    </columns>

                </TableView>

                <HBox alignment="CENTER_RIGHT"
                    spacing="20">

                    <Button text="Show All Books"
                            onAction="#showAllIssuesOnAction"
                            styleClass="primary-button"/>

                    <Button text="Show Overdue Books"
                            onAction="#showOverdueBooksOnAction"
                            styleClass="primary-button"/>

                    <Button text="Return Book"
                            onAction="#returnBookOnAction"
                            styleClass="primary-button"/>

                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="edu.icet.controller.BooksPageController"
            styleClass="root-container">

    <left>
        <VBox prefWidth="220"
              spacing="20"
              styleClass="sidebar">

            <padding>
                <Insets top="30" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="LibraFlow"
                   styleClass="logo"/>

            <Label text="MAIN MENU"
                   styleClass="menu-heading"/>

            <Button text="Dashboard"
                    onAction="#showDashboardOnAction"
                    styleClass="menu-button"/>

            <Button text="Books"
                    styleClass="menu-button, active-menu"/>

            <Button text="Members"
                    styleClass="menu-button"/>

            <Button text="Issue &amp; Return"
                    styleClass="menu-button"/>

            <Button text="Reports"
                    styleClass="menu-button"/>

        </VBox>
    </left>

    <center>
        <VBox spacing="25"
              styleClass="main-content">

            <padding>
                <Insets top="30" right="30" bottom="30" left="30"/>
            </padding>

            <VBox spacing="5">
                <Label text="Book Management"
                       styleClass="page-title"/>

                <Label text="Manage books available in your library."
                       styleClass="subtitle"/>
            </VBox>

            <HBox spacing="15"
                  alignment="CENTER_LEFT">

                <TextField fx:id="searchField"
                           promptText="Search by title, author or ISBN..."
                           onKeyReleased="#searchBooks"
                           HBox.hgrow="ALWAYS"/>

                <Button text="+ Add Book"
                        onAction="#showAddBookFormOnAction"
                        style="
                                -fx-text-fill: black;
                                -fx-cursor: hand;"
                        styleClass="primary-button"/>

                <Button
                        text="Edit Book"
                        onAction="#editBookOnAction"
                        style="
                                -fx-text-fill: black;
                                -fx-cursor: hand;" />

                <Button
                        text="Delete Book"
                        onAction="#deleteBookOnAction"
                        style="-fx-background-color: #dc2626;
                                -fx-text-fill: white;
                                   -fx-cursor: hand;" />

            </HBox>

            <VBox spacing="15"
                  styleClass="transactions-card"
                  VBox.vgrow="ALWAYS">

                <Label text="All Books"
                       styleClass="section-title"/>

                <TableView fx:id="booksTable"
                           VBox.vgrow="ALWAYS">

                    <columns>

                        <TableColumn fx:id="isbnColumn"
                                     text="ISBN"
                                     prefWidth="130"/>

                        <TableColumn fx:id="titleColumn"
                                     text="Title"
                                     prefWidth="200"/>

                        <TableColumn fx:id="authorColumn"
                                     text="Author"
                                     prefWidth="160"/>

                        <TableColumn fx:id="categoryColumn"
                                     text="Category"
                                     prefWidth="130"/>

                        <TableColumn fx:id="quantityColumn"
                                     text="Quantity"
                                     prefWidth="90"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>
    </center>

</BorderPane>

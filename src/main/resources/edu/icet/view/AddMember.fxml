<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="edu.icet.controller.AddMemberPageController"
           style="-fx-background-color: rgba(20, 35, 55, 0.55);">

    <VBox spacing="18"
          style="-fx-background-color: white;
                 -fx-padding: 30;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.20), 20, 0.2, 0, 5);">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="14">

            <StackPane minWidth="48"
                       minHeight="48"
                       style="-fx-background-color: #E8F0FF;
                              -fx-background-radius: 10;">

                <Label text="👥"
                       style="-fx-font-size: 24;"/>

            </StackPane>

            <VBox spacing="5" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel"
                        text="Add New Member"
                       style="-fx-font-size: 22;
                              -fx-font-weight: bold;
                              -fx-text-fill: #172B4D;"/>

                <Label fx:id="subTitleLabel"
                        text="Enter the member details below to register a new member."
                       wrapText="true"
                       style="-fx-font-size: 12;
                              -fx-text-fill: #718096;"/>
            </VBox>

            <Button text="✕"
                    onAction="#closeFormOnAction"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #718096;
                           -fx-font-size: 20;
                           -fx-cursor: hand;"/>

        </HBox>

        <!-- Name -->
        <VBox spacing="7">
            <Label text="Full Name"
                   style="-fx-font-size: 13;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243B53;"/>

            <TextField fx:id="nameField"
                       promptText="Enter full name"
                       prefHeight="42"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #D9E2F0;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 10;
                              -fx-font-size: 13;"/>
        </VBox>

        <!-- Email -->
        <VBox spacing="7">
            <Label text="Email Address"
                   style="-fx-font-size: 13;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243B53;"/>

            <TextField fx:id="emailField"
                       promptText="Enter email address"
                       prefHeight="42"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #D9E2F0;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 10;
                              -fx-font-size: 13;"/>
        </VBox>

        <!-- Phone -->
        <VBox spacing="7">
            <Label text="Phone Number"
                   style="-fx-font-size: 13;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243B4D;"/>

            <TextField fx:id="phoneField"
                       promptText="Enter phone number"
                       prefHeight="42"
                       maxWidth="Infinity"
                       style="-fx-background-color: white;
                              -fx-border-color: #D9E2F0;
                              -fx-border-radius: 6;
                              -fx-background-radius: 6;
                              -fx-padding: 10;
                              -fx-font-size: 13;"/>
        </VBox>

        <!-- Address -->
        <VBox spacing="7">
            <Label text="Address"
                   style="-fx-font-size: 13;
                          -fx-font-weight: bold;
                          -fx-text-fill: #243B53;"/>

            <TextArea fx:id="addressField"
                      promptText="Enter full address"
                      prefHeight="75"
                      wrapText="true"
                      style="-fx-background-color: white;
                             -fx-border-color: #D9E2F0;
                             -fx-border-radius: 6;
                             -fx-background-radius: 6;
                             -fx-font-size: 13;"/>
        </VBox>

        <!-- Divider -->
        <Region minHeight="1"
                maxHeight="1"
                style="-fx-background-color: #E5EAF1;"/>

        <!-- Buttons -->
        <HBox alignment="CENTER_RIGHT" spacing="12">

            <Button text="Cancel"
                    onAction="#closeFormOnAction"
                    prefHeight="42"
                    prefWidth="105"
                    style="-fx-background-color: #F0F4FA;
                           -fx-text-fill: #526581;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;"/>

            <Button fx:id="btnSave"
                    text="Save Member"
                    onAction="#saveMemberOnAction"
                    prefHeight="42"
                    prefWidth="145"
                    style="-fx-background-color: #2878F0;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-cursor: hand;"/>

        </HBox>

    </VBox>

</StackPane>